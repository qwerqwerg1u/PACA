local Step = require("prometheus.step")
local RandomStrings = require("prometheus.randomStrings")
local Parser = require("prometheus.parser")
local Enums = require("prometheus.enums")
local logger = require("logger")

local AntiTamper = Step:extend()

AntiTamper.Name = "PACA Anti Tamper"
AntiTamper.Description = "PACA runtime integrity and tamper detection."
AntiTamper.SettingsDescriptor = {
    UseDebug = {
        type = "boolean",
        default = true,
        description = "Enable debug-based integrity checks when available.",
    },
}

local function generateSanityCheck()
    local answers = {}
    local count = math.random(3, 8)
    local marker = RandomStrings.randomString()
    local parts = {}

    local function add(fmt, ...)
        parts[#parts + 1] = string.format(fmt, ...)
    end

    add("do\n")
    add("local valid = %q\n", marker)
    add("local expected = %q\n", marker)
    add("if valid ~= expected then error('PACA:TamperDetected', 0) end\n")

    for i = 1, count do
        answers[i] = math.random(0, 1) == 1
        add("local check%d = %s\n", i, tostring(answers[i]))
        add(
            "if check%d ~= %s then error('PACA:TamperDetected', 0) end\n",
            i,
            tostring(answers[i])
        )
    end

    add("end\n")
    return table.concat(parts)
end

function AntiTamper:init(settings)
    settings = settings or {}
    self.UseDebug = settings.UseDebug ~= false
end

function AntiTamper:apply(ast, pipeline)
    if pipeline and pipeline.PrettyPrint then
        logger:warn(
            string.format(
                '"%s" cannot be used with PrettyPrint, ignoring "%s"',
                self.Name,
                self.Name
            )
        )
        return ast
    end

    local code = generateSanityCheck()

    if self.UseDebug then
        code = code .. [[
do
    local dbg = debug
    if type(dbg) == "table" and type(dbg.info) == "function" then
        local ok, result = pcall(function()
            return dbg.info(1, "s")
        end)

        if not ok or type(result) ~= "string" then
            error("PACA:TamperDetected", 0)
        end
    end
end
]]
    end

    code = code .. [[
do
    local originalPcall = pcall
    local reached = false

    local ok = originalPcall(function()
        reached = true
    end)

    if not ok or not reached then
        error("PACA:TamperDetected", 0)
    end

    local ok2, err = originalPcall(function()
        error("PACA_CHECK", 0)
    end)

    if ok2 or type(err) ~= "string" then
        error("PACA:TamperDetected", 0)
    end

    if not string.find(err, "PACA_CHECK", 1, true) then
        error("PACA:TamperDetected", 0)
    end
end
]]

    local parsed = Parser:new({
        LuaVersion = Enums.LuaVersion.Lua51,
    }):parse(code)

    local first = parsed.body.statements[1]

    if not first then
        error("PACA Anti-Tamper: failed to generate check")
    end

    first.body.scope:setParent(ast.body.scope)
    table.insert(ast.body.statements, 1, first)

    return ast
end

return AntiTamper
